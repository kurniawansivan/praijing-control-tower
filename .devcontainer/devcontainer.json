{
  "name": "Praijing Control Tower",
  "build": { "dockerfile": "Dockerfile" },

  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22",
      "pnpmVersion": "none",
      "yarnVersion": "none"
    }
  },

  "workspaceFolder": "/workspaces/praijing-control-tower",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/scripts/postgres-init.sh",
  "forwardPorts": [8000, 5173, 5432],

  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "sqltools.connections": [
          {
            "name": "Praijing Postgres (DevContainer)",
            "driver": "PostgreSQL",
            "server": "localhost",
            "port": 5432,
            "database": "praijing",
            "username": "app",
            "password": "app",
            "previewLimit": 50
          }
        ]
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "svelte.svelte-vscode",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
